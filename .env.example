# Use a long random value in production, for example:
# openssl rand -base64 32
CUSTOMER_PORTAL_SESSION_SECRET=replace-with-a-long-random-secret

# Used by the offer calculator verification code hashing. Use a different long random value.
SESSION_SECRET=replace-with-another-long-random-secret

# Local Docker/PostgreSQL default. Change this on your VPS.
DATABASE_URL=postgresql://amigos:amigos_dev_password@localhost:5432/amigos_maler

# First admin bootstrap login. Change both before production.
ADMIN_EMAIL=admin@amigos-maler.ch
ADMIN_PASSWORD=change-this-admin-password

# Stripe Checkout. Required only when live invoice payments are enabled.
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/customer/invoices?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/customer/invoices?payment=cancelled

# WhatsApp Business Cloud API. Required only when appointment notifications are enabled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_scheduled

# Resend email delivery for the offer calculator verification code.
# Without these values, codes are only logged in development.
RESEND_API_KEY=
OFFER_EMAIL_FROM="Amigos Maler <no-reply@your-domain.ch>"

# Public click-to-chat number for the floating WhatsApp website button.
NEXT_PUBLIC_WHATSAPP_NUMBER=41790000000

# Public website chatbot. Keep false to stop live polling; set true before deploying live chat.
NEXT_PUBLIC_LIVE_CHAT_ENABLED=false
