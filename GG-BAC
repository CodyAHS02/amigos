	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const sizeSelect = document.getElementById("sizeSelect");
			const customSizeWrapper = document.getElementById("customSizeWrapper");
			const quantitySelect = document.getElementById("quantitySelect");
			const customQtyWrapper = document.getElementById("customQtyWrapper");
			const pricePreview = document.getElementById("pricePreview");

			function calculatePrice() {
				let size = sizeSelect.value;
				let quantity = quantitySelect.value;
				let width = 0, height = 0;

				if (size === "custom") {
					width = parseFloat(document.getElementById("customWidth").value) || 0;
					height = parseFloat(document.getElementById("customHeight").value) || 0;
				} else {
					if (size === "small") width = height = 2;
					if (size === "medium") width = height = 4;
					if (size === "large") width = height = 6;
				}

				if (quantity === "custom") {
					quantity = parseInt(document.getElementById("customQuantity").value) || 0;
				}

				let basePrice = 0.5; // per square inch
				let area = width * height;
				let unitPrice = area * basePrice;
				let total = unitPrice * quantity;

				if (!isNaN(total) && total > 0) {
					pricePreview.innerText = total.toFixed(2);
				} else {
					pricePreview.innerText = "0.00";
				}
			}

			// Show/Hide Custom Fields
			sizeSelect.addEventListener("change", function () {
				customSizeWrapper.style.display = this.value === "custom" ? "block" : "none";
				calculatePrice();
			});

			quantitySelect.addEventListener("change", function () {
				customQtyWrapper.style.display = this.value === "custom" ? "block" : "none";
				calculatePrice();
			});

			// Recalculate on change
			document.querySelectorAll("#customStickerForm input, select").forEach(input => {
				input.addEventListener("input", calculatePrice);
			});

			// Start Designing Button Click
			document.getElementById("startDesigning").addEventListener("click", function () {
				const product = document.getElementById("productSelect").value;
				if (!product) return alert("Please select a product");

				const size = sizeSelect.value;
				const width = document.getElementById("customWidth").value || "";
				const height = document.getElementById("customHeight").value || "";
				const quantity = quantitySelect.value === "custom"
					? document.getElementById("customQuantity").value
					: quantitySelect.value;

				let url = `/product/${product}/?size=${size}&quantity=${quantity}`;
				if (size === "custom") {
					url += `&width=${width}&height=${height}`;
				}

				window.location.href = url;
			});
		});
	</script>

